# Server-side Gemini API key used to extract menu items/prices from receipt photos.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for extraction (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Google Apps Script web app URL that persists imports to Google Sheets.
# See google-apps-script/README.md for how to deploy it.
NEXT_PUBLIC_GAS_URL=
